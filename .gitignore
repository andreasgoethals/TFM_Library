# >100MB — exceeds the GitHub file limit; regenerate locally via
# scripts/dumps/refresh_repositories.py --only "TabPFN Wide.txt" (see README).
repositories/TabPFN Wide.txt

# Scratch files left by an interrupted or failed atomic refresh:
# refresh_repositories.py / source_snapshot.py (*.refresh.tmp) and
# refresh_external_sources.py (.source-*.tmp).
*.refresh.tmp
repositories/.source-*.tmp

# Per-project notes written by DOWNSTREAM repositories inside their copy of
# this folder (see PROJECT_SPECIFIC.template.md). Ignored here so a consuming
# project can keep its own notes next to the literature without ever dirtying
# this repository's git status or accidentally pushing project-specific
# material into the shared library.
PROJECT_SPECIFIC.md

# OS / editor junk
Thumbs.db
.DS_Store
__pycache__/
*.pyc

# local virtualenv for the maintenance scripts
.venv/
